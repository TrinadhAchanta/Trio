# Copy to backend/.env and fill in. Never commit the real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://trio:trio@localhost:5432/trio
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false

# AI providers: add any you have. Leave blank to disable that provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Built-in Mock provider for demos/tests (clearly labeled in the UI). Set false in production.
ENABLE_MOCK_PROVIDER=true

STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
MAX_OUTPUT_TOKENS=4096
DAILY_COST_LIMIT_USD=5.0

# Optional: JSON file overriding the model catalog (ids, labels, prices). See models.example.json.
# TRIO_MODEL_CATALOG=./models.json
